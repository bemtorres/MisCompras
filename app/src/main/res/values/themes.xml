<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.MisCompras" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>

        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>

        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>

        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>

        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        <item name="colorSurfaceInverse">@color/md_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/md_inverse_on_surface</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.MisCompras" parent="Base.Theme.MisCompras" />

    <style name="Theme.MisCompras.Green" parent="Base.Theme.MisCompras" />

    <style name="Theme.MisCompras.Blue" parent="Base.Theme.MisCompras">
        <item name="colorPrimary">@color/theme_blue_primary</item>
        <item name="colorPrimaryContainer">@color/theme_blue_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_blue_on_container</item>
    </style>

    <style name="Theme.MisCompras.Purple" parent="Base.Theme.MisCompras">
        <item name="colorPrimary">@color/theme_purple_primary</item>
        <item name="colorPrimaryContainer">@color/theme_purple_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_purple_on_container</item>
    </style>

    <style name="Theme.MisCompras.Orange" parent="Base.Theme.MisCompras">
        <item name="colorPrimary">@color/theme_orange_primary</item>
        <item name="colorPrimaryContainer">@color/theme_orange_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_orange_on_container</item>
    </style>

    <style name="Theme.MisCompras.Red" parent="Base.Theme.MisCompras">
        <item name="colorPrimary">@color/theme_red_primary</item>
        <item name="colorPrimaryContainer">@color/theme_red_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_red_on_container</item>
    </style>

    <style name="Theme.MisCompras.Supermarket" parent="Base.Theme.MisCompras">
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Tipografía -->
    <style name="TextAppearance.MisCompras.ScreenTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.MisCompras.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.MisCompras.Amount" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.MisCompras.AmountBig" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.MisCompras.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.MisCompras.ItemName" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Componentes -->
    <style name="Widget.MisCompras.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLowest</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">@color/ripple_primary</item>
    </style>

    <style name="Widget.MisCompras.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLowest</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/ripple_primary</item>
    </style>

    <style name="Widget.MisCompras.Card.Soft" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.MisCompras.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.TitleSmall</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="Widget.MisCompras.Button.Large" parent="Widget.Material3.Button">
        <item name="cornerRadius">20dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.TitleMedium</item>
    </style>

    <style name="Widget.MisCompras.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.TitleSmall</item>
    </style>

    <style name="Widget.MisCompras.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">16dp</item>
    </style>

    <!-- Importes que se reducen automaticamente para que quepan cifras grandes ($1.000.000) -->
    <style name="Widget.MisCompras.Amount.FitBig" parent="">
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMaxTextSize">36sp</item>
        <item name="android:autoSizeMinTextSize">16sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Widget.MisCompras.Amount.Fit" parent="">
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMaxTextSize">28sp</item>
        <item name="android:autoSizeMinTextSize">14sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Widget.MisCompras.Amount.FitSmall" parent="">
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMaxTextSize">18sp</item>
        <item name="android:autoSizeMinTextSize">11sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Widget.MisCompras.Amount.FitBody" parent="">
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMaxTextSize">14sp</item>
        <item name="android:autoSizeMinTextSize">9sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Widget.MisCompras.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">18dp</item>
        <item name="boxCornerRadiusTopEnd">18dp</item>
        <item name="boxCornerRadiusBottomStart">18dp</item>
        <item name="boxCornerRadiusBottomEnd">18dp</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
    </style>

    <style name="Widget.MisCompras.Chip.Assist" parent="Widget.Material3.Chip.Assist">
        <item name="chipCornerRadius">14dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.LabelLarge</item>
    </style>

    <style name="Widget.MisCompras.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">14dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.LabelLarge</item>
    </style>

    <style name="Widget.MisCompras.Chip.Status" parent="Widget.Material3.Chip.Assist">
        <item name="chipCornerRadius">10dp</item>
        <item name="chipMinHeight">28dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.LabelSmall</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <style name="Widget.MisCompras.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">?attr/colorSurfaceContainerLowest</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.MisCompras.BottomNav.Indicator</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Material3.LabelMedium</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Material3.LabelMedium</item>
    </style>

    <style name="Widget.MisCompras.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimaryContainer</item>
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
    </style>

    <style name="ThemeOverlay.MisCompras.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.MisCompras.BottomSheet</item>
    </style>

    <style name="Widget.MisCompras.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?attr/colorSurfaceContainerLowest</item>
        <item name="shapeAppearance">@style/ShapeAppearanceOverlay.MisCompras.BottomSheet</item>
    </style>

    <style name="ShapeAppearanceOverlay.MisCompras.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
