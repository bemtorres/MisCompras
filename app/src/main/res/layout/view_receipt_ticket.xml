<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- CABECERA PRINCIPAL: LOGO + MIS COMPRAS + ESTADO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Logo en la esquina superior -->
        <ImageView
            android:id="@+id/receipt_logo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher_mc" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Nombre de la aplicación "Mis Compras" -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.02"
                android:text="@string/app_name"
                android:textColor="#0F172A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/receipt_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="@string/receipt_header_subtitle"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Badge de estado y fecha -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/receipt_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#DCFCE7"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#15803D"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="COMPLETADA" />

            <TextView
                android:id="@+id/receipt_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                tools:text="27/09/2026 · 19:30" />
        </LinearLayout>
    </LinearLayout>

    <!-- Línea divisoria elegante -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginVertical="16dp"
        android:background="#E2E8F0" />

    <!-- INFORMACIÓN DE LA LISTA -->
    <TextView
        android:id="@+id/receipt_list_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="Supermercado Líder Quincenal" />

    <TextView
        android:id="@+id/receipt_list_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#64748B"
        android:textSize="13sp"
        tools:text="Compra quincenal · 8 productos" />

    <!-- TARJETA DESTACADA DE TOTALES FINANCIEROS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#F8FAFC"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Fila Total Real / Pagado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/receipt_total_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.05"
                android:text="TOTAL PAGADO"
                android:textColor="#475569"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/receipt_total_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#0F172A"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="$22.400" />
        </LinearLayout>

        <!-- Separador dentro de la tarjeta -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#E2E8F0" />

        <!-- Desglose de 3 columnas: Estimado | Descuento | Diferencia/Ahorro -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Estimado -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="ESTIMADO"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/receipt_estimated_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#334155"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="$24.900" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:background="#E2E8F0" />

            <!-- Descuentos -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="DESCUENTOS"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/receipt_discount_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#16A34A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="-$1.200" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:background="#E2E8F0" />

            <!-- Diferencia / Ahorro -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/receipt_diff_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="AHORRASTE"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/receipt_diff_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#16A34A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="+$2.500" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- CABECERA DE LA TABLA DE PRODUCTOS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_weight="1"
            android:letterSpacing="0.05"
            android:text="@string/receipt_col_product"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:text="@string/receipt_col_qty"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:letterSpacing="0.05"
            android:text="@string/receipt_col_price"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="92dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:letterSpacing="0.05"
            android:text="@string/receipt_col_total"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:layout_width="22dp"
            android:layout_height="1dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0" />

    <!-- CONTENEDOR DINÁMICO DE FILAS DE PRODUCTOS -->
    <LinearLayout
        android:id="@+id/receipt_items_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="#E2E8F0" />

    <!-- RESUMEN FINAL Y PIE DE COMPROBANTE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/receipt_summary_counts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#475569"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="✓ 8 productos comprados · 1 sin stock" />

        <TextView
            android:id="@+id/receipt_ticket_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            tools:text="#MC-LIST-14" />
    </LinearLayout>

    <!-- PIE MARCA DE AGUA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="vertical">

        <View
            android:layout_width="160dp"
            android:layout_height="1dp"
            android:layout_marginBottom="10dp"
            android:background="#CBD5E1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.02"
            android:text="@string/receipt_footer_caption"
            android:textColor="#64748B"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
